public class ModuloClientes extends Modulo<Cliente> {

    @Override
    public void registrarElemento(Cliente cliente) {
        lista.add(cliente);
    }

    @Override
    public void eliminarElemento(int id) {
        lista.removeIf(c -> c.getIdCliente() == id);
    }

    @Override
    public void modificarElemento(int id, Cliente nuevoCliente) {
        for (int i = 0; i < lista.size(); i++) {
            if (lista.get(i).getIdCliente() == id) {
                lista.set(i, nuevoCliente);
                break;
            }
        }
    }

    @Override
    public Cliente obtenerDatos(int id) {
        for (Cliente cliente : lista) {
            if (cliente.getIdCliente() == id) {
                return cliente;
            }
        }
        return null;
    }
}
